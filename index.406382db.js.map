"use strict";
document.querySelector(".wall").addEventListener("click", function(e) {
    var wall = document.querySelector(".wall");
    var spider = document.querySelector(".spider");
    if (!wall || !spider || !wall.contains(e.target)) return;
    var wallParams = wall.getBoundingClientRect();
    var spiderLeft = e.clientX - wallParams.left - wall.clientLeft - spider.offsetWidth / 2;
    if (spiderLeft < 0) spiderLeft = 0;
    var maxLeftPosition = wall.clientWidth - spider.offsetWidth;
    if (spiderLeft > maxLeftPosition) spiderLeft = maxLeftPosition;
    var spiderTop = e.clientY - wallParams.top - wall.clientTop - spider.offsetHeight / 2;
    if (spiderTop < 0) spiderTop = 0;
    var maxTopPosition = wall.clientHeight - spider.offsetHeight;
    if (spiderTop > maxTopPosition) spiderTop = maxTopPosition;
    spider.style.left = "".concat(spiderLeft, "px");
    spider.style.top = "".concat(spiderTop, "px");
});

